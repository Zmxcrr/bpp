// Простой решето Эратосфена до 100000 (включительно)
// Печатаем: "<count> <last_prime> <checksum_first_100>"

primes_up_to = function(n)
    if n < 2 then
        return []
    end if

    isPrime = [true] * (n + 1)
    isPrime[0] = false
    isPrime[1] = false

    limit = floor(sqrt(n))
    for p in range(2, limit + 1)
        if isPrime[p] then
            m = p * p
            while m <= n
                isPrime[m] = false
                m = m + p
            end while
        end if
    end for

    res = []
    for i in range(2, n + 1)
        if isPrime[i] then
            push(res, i)
        end if
    end for
    return res
end function

sum_first_k = function(xs, k)
    s = 0
    limit = len(xs)
    if k < limit then
        limit = k
    end if
    for i in range(limit)
        s = s + xs[i]
    end for
    return s
end function

N = 100000
ps = primes_up_to(N)
cnt = len(ps)
lastp = ps[-1]
chk100 = sum_first_k(ps, 100)

println(to_string(cnt) + " " + to_string(lastp) + " " + to_string(chk100))

