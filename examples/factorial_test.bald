sieve_of_eratosthenes = function(n)
    if n < 2 then
        return []
    end if

    isPrime = []
    for i in range(0, n + 1, 1)
        push(isPrime, true)
    end for

    isPrime[0] = false
    isPrime[1] = false

    limit = floor(sqrt(n))
    for p in range(2, limit + 1, 1)
        if isPrime[p] then
            m = p * p
            while m <= n
                isPrime[m] = false
                m = m + p
            end while
        end if
    end for

    primes = []
    for i in range(2, n + 1, 1)
        if isPrime[i] then
            push(primes, i)
        end if
    end for

    return primes
end function

show_primes = function(primes, show_count)
    if len(primes) <= show_count then
        return join(primes, ", ")
    end if

    first_part = []
    for i in range(0, show_count / 2, 1)
        push(first_part, primes[i])
    end for

    last_part = []
    start = len(primes) - show_count / 2
    for i in range(start, len(primes), 1)
        push(last_part, primes[i])
    end for

    return join(first_part, ", ") + " ... " + join(last_part, ", ")
end function

sum_first_k = function(arr, k)
    sum = 0
    limit = len(arr)
    if k < limit then
        limit = k
    end if
    for i in range(0, limit, 1)
        sum = sum + arr[i]
    end for
    return sum
end function

println("ТЕСТИРОВАНИЕ РАЗНЫХ ПРЕДЕЛОВ:")

test_limits = [30, 100, 1000, 10000]

for limit in test_limits
    println("")
    println("Генерируем простые числа до " + to_string(limit) + ":")

    primes = sieve_of_eratosthenes(limit)
    count = len(primes)

    if count > 0 then
        first_prime = primes[0]
        last_prime = primes[count - 1]
        first_10_sum = sum_first_k(primes, 10)

        println("Найдено простых чисел: " + to_string(count))
        println("Первое простое число: " + to_string(first_prime))
        println("Последнее простое число: " + to_string(last_prime))

        if limit <= 100 then
            println("Все простые числа: " + join(primes, ", "))
        else
            println("Примеры: " + show_primes(primes, 20))
        end if

        println("Сумма первых 10: " + to_string(first_10_sum))

        if limit == 100 then
            println("Ожидалось 25 простых до 100: " + (count == 25 and "ВЕРНО" or "ОШИБКА"))
        end if
        if limit == 1000 then
            println("Ожидалось 168 простых до 1000: " + (count == 168 and "ВЕРНО" or "ОШИБКА"))
        end if
        if limit == 10000 then
            println("Ожидалось 1229 простых до 10000: " + (count == 1229 and "ВЕРНО" or "ОШИБКА"))
        end if
    else
        println("Простые числа не найдены")
    end if
end for

println("")
println("ФИНАЛЬНЫЙ ТЕСТ: БОЛЬШОЙ ПРЕДЕЛ (100,000)")

big_limit = 100000
println("Генерируем простые числа до " + to_string(big_limit) + "...")

big_primes = sieve_of_eratosthenes(big_limit)
big_count = len(big_primes)

if big_count > 0 then
    big_last = big_primes[big_count - 1]
    big_first_100_sum = sum_first_k(big_primes, 100)

    println("РЕЗУЛЬТАТЫ БОЛЬШОГО ТЕСТА:")
    println("Всего найдено простых чисел: " + to_string(big_count))
    println("Наибольшее простое число < 100000: " + to_string(big_last))
    println("Сумма первых 100 простых: " + to_string(big_first_100_sum))

    println("Первые 20 простых: " + show_primes(big_primes, 20))
    println("Последние 10 простых: ")

    last_10 = []
    start = big_count - 10
    for i in range(start, big_count, 1)
        push(last_10, big_primes[i])
    end for
    println("      " + join(last_10, ", "))

    known_count = 9592
    known_last = 99991
    known_sum = 24133

    println("")
    println("ВЕРИФИКАЦИЯ РЕЗУЛЬТАТОВ:")
    println("Ожидаемое количество: " + to_string(known_count))
    println("Получено: " + to_string(big_count))
    println("Количество верно: " + (big_count == known_count and "ДА" or "НЕТ"))

    println("  Ожидаемое последнее простое: " + to_string(known_last))
    println("  Получено: " + to_string(big_last))
    println("  Последнее простое верно: " + (big_last == known_last and "ДА" or "НЕТ"))

    println("  Ожидаемая сумма первых 100: " + to_string(known_sum))
    println("  Получено: " + to_string(big_first_100_sum))
    println("  Сумма верна: " + (big_first_100_sum == known_sum and "ДА" or "НЕТ"))

    all_correct = (big_count == known_count and big_last == known_last and big_first_100_sum == known_sum)

    println("")
    if all_correct then
        println("ЗАКЛЮЧЕНИЕ: Генерация простых чисел работает корректно")
        println("Решето Эратосфена реализовано корректно")
        println("Алгоритм успешно обработал " + to_string(big_limit) + " чисел!")
    else
        println("Обнаружены расхождения с ожидаемыми значениями")
    end if
else
    println("Не удалось сгенерировать простые числа")
end if