// comprehensive_demo.bald - Полная демонстрация всех возможностей Bald++

println("🚀 КОМПЛЕКСНАЯ ДЕМОНСТРАЦИЯ BALD++")
println("==================================")
println("Демонстрация трех основных алгоритмических задач:")
println("1. Рекурсивное вычисление факториала")
println("2. Сортировка больших массивов")
println("3. Генерация простых чисел (Решето Эратосфена)")
println("")

// =============================================================================
// ЗАДАЧА 1: ФАКТОРИАЛ
// =============================================================================

println("📋 ЗАДАЧА 1: РЕКУРСИВНОЕ ВЫЧИСЛЕНИЕ ФАКТОРИАЛА")
println("==============================================")

factorial = function(n)
    if n <= 1 then
        return 1
    end if
    return n * factorial(n - 1)
end function

println("🧮 Демонстрация пошагового вычисления:")

// Показываем вычисление factorial(6)
n = 6
println("Вычисляем " + to_string(n) + "!:")
println("  " + to_string(n) + "! = " + to_string(n) + " × " + to_string(n-1) + "!")
println("  " + to_string(n-1) + "! = " + to_string(n-1) + " × " + to_string(n-2) + "!")
println("  " + to_string(n-2) + "! = " + to_string(n-2) + " × " + to_string(n-3) + "!")
println("  " + to_string(n-3) + "! = " + to_string(n-3) + " × " + to_string(n-4) + "!")
println("  " + to_string(n-4) + "! = " + to_string(n-4) + " × " + to_string(n-5) + "!")
println("  " + to_string(n-5) + "! = " + to_string(n-5) + " × " + to_string(n-6) + "!")
println("  " + to_string(n-6) + "! = 1 (базовый случай)")
println("")
println("🔄 Обратное вычисление:")
println("  1! = 1")
println("  2! = 2 × 1 = 2")
println("  3! = 3 × 2 = 6")
println("  4! = 4 × 6 = 24")
println("  5! = 5 × 24 = 120")
println("  6! = 6 × 120 = 720")
println("")
println("✅ Проверяем: factorial(6) = " + to_string(factorial(6)))

println("")
println("📊 Тестирование различных значений:")
test_values = [0, 1, 5, 10, 15, 20]
for val in test_values
    result = factorial(val)
    println("  factorial(" + to_string(val) + ") = " + to_string(result))
end for

println("✅ ЗАДАЧА 1 ВЫПОЛНЕНА: Рекурсия работает корректно!")
println("")

// =============================================================================
// ЗАДАЧА 2: СОРТИРОВКА МАССИВОВ
// =============================================================================

println("📋 ЗАДАЧА 2: СОРТИРОВКА БОЛЬШИХ МАССИВОВ")
println("========================================")

make_reverse_array = function(size)
    arr = []
    i = size - 1
    while i >= 0
        push(arr, i)
        i = i - 1
    end while
    return arr
end function

calculate_sum = function(arr)
    total = 0
    for x in arr
        total = total + x
    end for
    return total
end function

show_array_part = function(arr, show_count)
    if len(arr) <= show_count then
        return "[" + join(arr, ", ") + "]"
    end if

    first = []
    last = []

    for i in range(0, show_count/2, 1)
        push(first, arr[i])
    end for

    start = len(arr) - show_count/2
    for i in range(start, len(arr), 1)
        push(last, arr[i])
    end for

    return "[" + join(first, ", ") + " ... " + join(last, ", ") + "]"
end function

println("🔄 Демонстрация на небольшом массиве:")
small_array = make_reverse_array(10)
println("  ДО сортировки:    " + show_array_part(small_array, 20))

sort(small_array)
println("  ПОСЛЕ сортировки: " + show_array_part(small_array, 20))
println("  ✅ Массив отсортирован корректно!")
println("")

println("📊 Тестирование разных размеров:")
sizes = [100, 1000, 10000]
for size in sizes
    test_array = make_reverse_array(size)
    original_sum = calculate_sum(test_array)

    println("  🔍 Массив из " + to_string(size) + " элементов:")
    println("    ДО:  " + show_array_part(test_array, 6) + " (сумма: " + to_string(original_sum) + ")")

    sort(test_array)
    sorted_sum = calculate_sum(test_array)

    println("    ПОСЛЕ: " + show_array_part(test_array, 6) + " (сумма: " + to_string(sorted_sum) + ")")
    println("    ✅ Результат: " + to_string(original_sum == sorted_sum and "УСПЕХ" or "ОШИБКА"))
end for

println("")
println("🎯 ФИНАЛЬНЫЙ ТЕСТ: 100,000 элементов")
huge_array = make_reverse_array(100000)
huge_original_sum = calculate_sum(huge_array)

println("  📊 Создан массив: [99999, 99998, ..., 1, 0]")
println("  📊 Размер: " + to_string(len(huge_array)) + " элементов")
println("  📊 Исходная сумма: " + to_string(huge_original_sum))
println("  🔄 Выполняем сортировку...")

sort(huge_array)
huge_sorted_sum = calculate_sum(huge_array)

println("  📊 РЕЗУЛЬТАТ:")
println("    Первый элемент: " + to_string(huge_array[0]))
println("    Последний элемент: " + to_string(huge_array[len(huge_array)-1]))
println("    Сумма после сортировки: " + to_string(huge_sorted_sum))
println("    ✅ Сумма сохранена: " + to_string(huge_original_sum == huge_sorted_sum and "ДА" or "НЕТ"))

println("✅ ЗАДАЧА 2 ВЫПОЛНЕНА: Сортировка работает идеально!")
println("")

// =============================================================================
// ЗАДАЧА 3: ПРОСТЫЕ ЧИСЛА
// =============================================================================

println("📋 ЗАДАЧА 3: ГЕНЕРАЦИЯ ПРОСТЫХ ЧИСЕЛ")
println("====================================")

generate_primes = function(limit)
    if limit < 2 then
        return []
    end if

    is_prime = []
    for i in range(0, limit + 1, 1)
        push(is_prime, true)
    end for

    is_prime[0] = false
    is_prime[1] = false

    sqrt_limit = floor(sqrt(limit))
    for p in range(2, sqrt_limit + 1, 1)
        if is_prime[p] then
            multiple = p * p
            while multiple <= limit
                is_prime[multiple] = false
                multiple = multiple + p
            end while
        end if
    end for

    primes = []
    for i in range(2, limit + 1, 1)
        if is_prime[i] then
            push(primes, i)
        end if
    end for

    return primes
end function

sum_array = function(arr)
    total = 0
    for x in arr
        total = total + x
    end for
    return total
end function

println("🔄 Демонстрация алгоритма Решето Эратосфена:")
println("  1. Создаем массив булевых значений")
println("  2. Отмечаем 0 и 1 как составные")
println("  3. Для каждого простого p отмечаем его кратные как составные")
println("  4. Собираем все оставшиеся простые числа")
println("")

small_primes = generate_primes(50)
println("📊 Простые числа до 50:")
println("  " + join(small_primes, ", "))
println("  Всего найдено: " + to_string(len(small_primes)))
println("")

println("📊 Тестирование разных пределов:")
limits = [100, 1000, 10000]
expected_counts = [25, 168, 1229]

for i in range(0, len(limits), 1)
    limit = limits[i]
    expected = expected_counts[i]

    primes = generate_primes(limit)
    count = len(primes)

    if count > 0 then
        last_prime = primes[count - 1]
        first_10_sum = sum_array([])

        // Считаем сумму первых 10
        for j in range(0, 10, 1)
            if j < count then
                first_10_sum = first_10_sum + primes[j]
            end if
        end for

        println("  🔍 До " + to_string(limit) + ": найдено " + to_string(count) + " простых (ожидалось " + to_string(expected) + ")")
        println("    Последнее простое: " + to_string(last_prime))
        println("    Сумма первых 10: " + to_string(first_10_sum))
        println("    ✅ Результат: " + to_string(count == expected and "ВЕРНО" or "НЕВЕРНО"))
    end if
end for

println("")
println("🎯 ФИНАЛЬНЫЙ ТЕСТ: 100,000")
final_primes = generate_primes(100000)
final_count = len(final_primes)
final_last = final_primes[final_count - 1]

// Считаем сумму первых 100
final_sum_100 = 0
for i in range(0, 100, 1)
    final_sum_100 = final_sum_100 + final_primes[i]
end for

println("  📊 РЕЗУЛЬТАТ:")
println("    Найдено простых чисел: " + to_string(final_count))
println("    Наибольшее простое < 100000: " + to_string(final_last))
println("    Сумма первых 100 простых: " + to_string(final_sum_100))
println("    ✅ Проверка: " + to_string(final_count) + " " + to_string(final_last) + " " + to_string(final_sum_100))

println("✅ ЗАДАЧА 3 ВЫПОЛНЕНА: Решето Эратосфена работает точно!")
println("")

