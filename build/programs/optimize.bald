println("⚡ БЕНЧМАРК ОПТИМИЗАЦИЙ КОМПИЛЯТОРА")
println("====================================")
println("")

// Массив с константными вычислениями
println("🔄 Инициализация массива...")
data = []
i = 0
while i < 1000
    // Куча константных выражений - будут свёрнуты в одно число
    value = 2 * 3 + 5 * 7 - 10 / 2 + 100 - 50 + 25
    push(data, value)
    i = i + 1
end while
println("  ✅ Создано " + to_string(len(data)) + " элементов")
println("")

// Вычисления с константами в циклах
println("🔄 Обработка данных...")
sum = 0
i = 0
while i < len(data)
    // Эти константы свернутся при компиляции
    multiplier = 10 * 10 / 50 + 5 - 3
    temp = data[i] * multiplier
    
    // Условие с константой - dead code elimination
    if 5 > 10 then
        temp = temp + 999999
    end if
    
    sum = sum + temp
    i = i + 1
end while
println("  Сумма: " + to_string(sum))
println("")

// Множество мёртвого кода
println("🗑️  Проверка мёртвого кода...")

if false then
    dead1 = 1 + 2 + 3 + 4 + 5
    dead2 = 10 * 20 * 30
    dead3 = 100 / 10 + 200 / 20
    println("Никогда не выполнится 1")
end if

if 100 < 50 then
    dead4 = 5 * 5 * 5 * 5
    dead5 = 7 + 7 + 7 + 7
    println("Никогда не выполнится 2")
end if

if 1 > 2 then
    dead6 = 999 - 888 + 777
    dead7 = 123 * 456
    println("Никогда не выполнится 3")
end if

println("  ✅ Мёртвый код удалён")
println("")

// Вложенные циклы с константами
println("🔄 Вложенные циклы...")
result = 0
i = 0
while i < 50
    j = 0
    while j < 50
        // Много константных операций
        c1 = 2 + 2
        c2 = 5 * 5
        c3 = 100 / 10
        c4 = 50 - 25
        c5 = 3 * 3 + 4 * 4
        
        combined = c1 + c2 + c3 + c4 + c5
        result = result + combined
        
        j = j + 1
    end while
    i = i + 1
end while
println("  Результат: " + to_string(result))
println("")

// Массив с вычислениями
println("🔄 Генерация чисел...")
numbers = []
i = 0
while i < 500
    // Константные выражения в каждой итерации
    val = (10 + 5) * (20 - 5) / 3 + 100 - 50
    push(numbers, val)
    i = i + 1
end while

// Обработка массива
println("🔄 Фильтрация...")
filtered = []
i = 0
while i < len(numbers)
    // Константа в условии
    threshold = 50 * 2 + 25 - 10
    
    if numbers[i] > threshold then
        push(filtered, numbers[i])
    end if
    
    // Больше мёртвого кода
    if false then
        push(filtered, 999)
    end if
    
    i = i + 1
end while
println("  Отфильтровано: " + to_string(len(filtered)) + " элементов")
println("")

// Финальные вычисления
println("🔄 Финальные вычисления...")
total = 0
i = 0
while i < len(filtered)
    // Куча константных операций
    k1 = 1 + 1
    k2 = 2 * 2
    k3 = 3 + 3
    k4 = 4 * 4
    k5 = 5 + 5
    k6 = 6 * 6
    k7 = 7 + 7
    k8 = 8 * 8
    
    coeff = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8
    total = total + filtered[i] / coeff
    
    i = i + 1
end while
println("  Итого: " + to_string(total))
println("")

// Ещё больше мёртвого кода
if 1 == 2 then
    x1 = 10 + 10
    x2 = 20 + 20
    x3 = 30 + 30
    x4 = 40 + 40
    x5 = 50 + 50
    println("Никогда")
end if

if 10 < 5 then
    y1 = 100 * 100
    y2 = 200 * 200
    y3 = 300 * 300
    println("Не выполнится")
end if

println("✅ БЕНЧМАРК ЗАВЕРШЁН!")
println("")
println("Для сравнения запустите:")
println("  БЕЗ оптимизаций: ./bald_interpreter --vm --stats program.bald")
println("  С оптимизациями: ./bald_interpreter --vm --optimize --stats program.bald")

